# Backend environment variables
# Copy to .env and fill in real values.

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
# Server-side only. NEVER expose to the frontend.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Comma-separated list of allowed frontend origins.
CORS_ORIGINS=http://localhost:5173,https://drivetrack.page,https://www.drivetrack.page

# LLM Extraction Settings
LLM_PROVIDER=groq
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=llama-3.3-70b-versatile
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# Clerk Authentication
CLERK_SECRET_KEY=sk_test_...
CLERK_ISSUER=https://your-instance.clerk.accounts.dev
CLERK_AUTHORIZED_PARTIES=http://localhost:5173,https://drivetrack.page,https://www.drivetrack.page
CLERK_PUBLISHABLE_KEY=pk_test_...

# Web Push Notifications (VAPID)
# Run `python backend/scripts/generate_vapid_keys.py` to generate keypair
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CLAIM_EMAIL=mailto:admin@placementtracker.app
